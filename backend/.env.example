# Server
PORT=5000
NODE_ENV=development

# Database - Windows Auth (default, no user/pass needed)
DB_HOST=localhost
DB_PORT=1433
DB_TRUSTED_CONNECTION=true
DB_NAME=gymer

# Database - SQL Auth (uncomment and set TRUSTED_CONNECTION=false)
# DB_USER=sa
# DB_PASSWORD=*** DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT (change in production)
JWT_ACCESS_SECRET=dev-acc...n
# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# CORS
CORS_ORIGIN=http://localhost:5173
