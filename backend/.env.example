# Server
PORT=5000
NODE_ENV=development

# Database - Windows Auth (default, no user/pass needed)
DB_HOST=localhost
DB_PORT=1433
DB_TRUSTED_CONNECTION=true
DB_NAME=gymer

# Database - SQL Auth (uncomment and set TRUSTED_CONNECTION=false)
# DB_USER=sa
# DB_PASSWORD=*** DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT (change in production)
JWT_ACCESS_SECRET=dev-acc...n
# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Bank transfer notifications (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_QR_IMAGE_URL=/images/payment/bank-qr.jpg
ORDER_CURRENCY=VND

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# CORS
CORS_ORIGIN=http://localhost:5173
